  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "tag-push"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 30,
      "build": [
        "./packages/ntfy-reverse-proxy",
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "npm",
          "path": "./packages/ntfy-reverse-proxy",
          "artifact": "ntfy-reverse-proxy"
        },
        {
          "to": "github-packages",
          "path": "./packages/ntfy-reverse-proxy",
          "artifact": "ntfy-reverse-proxy"
        },
        {
          "to": "cloudflare-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        }
      ]
    }
