{
  "project": {
    "name": {
      "title": "Reverse Proxy for ntfy",
      "slug": "ntfy-reverse-proxy"
    },
    "description": {
      "short": "Route webhooks and emails to ntfy through Cloudflare Workers, with automatic server failover",
      "long": "Route webhooks and emails from Statuspage.io, Synology DSM, Seerr, pfSense, UniFi, Outpost, Mailmask, and more into clean ntfy notifications. Long messages split cleanly, delivery fails over to a backup server, and an interactive CLI handles setup and deployment."
    },
    "keywords": [
      "ntfy",
      "reverse-proxy",
      "cloudflare-workers",
      "webhooks",
      "notifications",
      "statuspage",
      "synology",
      "seerr",
      "pfsense",
      "unifi",
      "transmission-vpn",
      "pfsense-actions",
      "discord-stonker-bot",
      "outpost"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "web"
    ],
    "startingYear": 2023,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
