{
  "name": "ntfy-reverse-proxy-project",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel 'dev:*'",
    "dev:workspaces": "turbo run dev",
    "prod": "nova utility run-scripts --sequential 'prod:*'",
    "prod:workspaces": "turbo run prod",
    "check": "nova utility run-scripts --sequential 'check:*'",
    "check:workspaces": "turbo run check --concurrency=2",
    "check:lint": "eslint . --max-warnings=0",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-scripts": "nova utility type-check --project tsconfig.scripts.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential 'build:*'",
    "build:workspaces": "turbo run build --concurrency=2",
    "deploy": "nova utility run-scripts --sequential 'deploy:*'",
    "deploy:workspaces": "turbo run deploy --concurrency=2",
    "clean": "nova utility run-scripts --parallel 'clean:*'",
    "clean:workspaces": "turbo run clean",
    "manage": "npm run manage --workspace packages/ntfy-reverse-proxy",
    "tail": "node ./scripts/tail-logs.mjs",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "allowScripts": {
    "core-js": false,
    "es5-ext": false,
    "esbuild": false,
    "fsevents": true,
    "node-pty@1.2.0-beta.14": true,
    "unrs-resolver": false,
    "workerd": false
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@cbnventures/nova": "0.27.3"
  },
  "devDependencies": {
    "jiti": "2.7.0",
    "prompts": "2.4.2",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
